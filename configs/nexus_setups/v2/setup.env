# v2 — frozen instruction + Nexus context pack
export NEXUS_URL="${NEXUS_URL:-http://localhost}"
export NEXUS_CONTEXT="${NEXUS_CONTEXT:-taubench-v2}"
export NEXUS_TIMEOUT="${NEXUS_TIMEOUT:-600}"
export NEXUS_QUERY_MODEL="${NEXUS_QUERY_MODEL:-claude-sonnet-5}"
export NEXUS_PROFILE="${NEXUS_PROFILE:-clo-nexus}"

# Historical agent defaults (launcher may override AGENT_LLM)
export SETUP_HISTORICAL_AGENT_LLM="openai/responses/gpt-5.5"
export SETUP_HISTORICAL_AGENT_LLM_ARGS='{"extra_body":{"reasoning_effort":"xhigh"}}'
export SETUP_HISTORICAL_USER_LLM="gpt-5.2"
export SETUP_HISTORICAL_USER_LLM_ARGS='{"reasoning_effort":"low"}'
export SETUP_DEFAULT_NUM_TRIALS=4
export SETUP_DEFAULT_SEED=300
export SETUP_DEFAULT_CONCURRENCY=8
export SETUP_USE_HARD_RULES=1
